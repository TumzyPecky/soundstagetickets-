# Copy this to .env for local use with a process manager that loads .env
# files, or set these directly in your host's dashboard (e.g. Render's
# Environment tab). None are required to run locally - sensible defaults
# are used - but ADMIN_PASSWORD should always be set before deploying
# anywhere public.

# Port the server listens on. Render sets this automatically - you
# normally don't need to set it yourself.
PORT=3000

# Host/interface to bind to. 0.0.0.0 is required on most hosts/containers;
# leave this as-is unless you know you need something else.
HOST=0.0.0.0

# Set to "production" when deployed. This enables the Secure flag on the
# admin bearer-token-issuing login response's cookie handling paths (kept
# for parity with browsers that inspect it) - the actual admin auth uses
# a bearer token, not a cookie, so this admin site can live on a
# different origin/domain than this backend.
NODE_ENV=production

# The exact URL of your separately-deployed admin site (the sst-admin
# project), e.g. https://sst-admin.onrender.com. Restricts which origin's
# browser JavaScript can call /api/admin/* endpoints (CORS). Leave unset
# during local setup/testing - it defaults to "*" (any origin allowed) -
# but set this before relying on the app for anything real.
ADMIN_ORIGIN=https://your-admin-site.example.com

# Where the JSON data file is stored. On Render's default (ephemeral) web
# service disk, data is wiped on every deploy/restart. To persist data,
# attach a Persistent Disk (see render.yaml) mounted at this path.
DATA_DIR=/var/data

# Admin account created on first run (only used if no admin exists yet in
# the data file). ALWAYS set ADMIN_PASSWORD before deploying publicly -
# the built-in fallback (ChangeMe123!) is meant for local testing only.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-to-something-strong

# --- Payments (manual bank transfer + receipt review) ---
# There is no payment gateway - buyers transfer money directly to this
# account, upload a screenshot of the transfer as proof, and an admin
# reviews it in the admin panel before tickets are issued. These three
# values are shown on the checkout page exactly as entered here.
BANK_NAME=Opay
BANK_ACCOUNT_NAME=Your Name or Business Name
BANK_ACCOUNT_NUMBER=0000000000

# The exact public URL this server is reachable at once deployed, e.g.
# https://sound-stage-tickets.onrender.com. Not required for payments to
# work, but used for a couple of absolute links (e.g. in emails).
PUBLIC_APP_URL=https://your-app.onrender.com

# --- Email (Gmail SMTP) ---
# The Gmail address tickets are sent from.
GMAIL_USER=yourevent@gmail.com

# An "App Password" (NOT your normal Gmail password). Requires 2-Step
# Verification to be enabled on the Google account first, then create
# one at: https://myaccount.google.com/apppasswords
# Choose "Mail" as the app. Paste the 16-character password below
# (spaces are fine, they're stripped automatically).
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Display name shown as the email sender, e.g. "Soundstage Live Concert".
MAIL_FROM_NAME=Soundstage Live Concert
